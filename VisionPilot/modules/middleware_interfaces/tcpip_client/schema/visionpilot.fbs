namespace visionpilot.wire;

enum Warning : ubyte {
    None = 0,
    FCW = 1,
    AEB = 2,
    LLDW = 3,
    RLDW = 4
}


struct Detection {
    x1:float;
    y1:float;
    x2:float;
    y2:float;
    score:float;
    class_id:int;
}


table AutoDriveOutput {
    dist_normalized:float = 0.0;
    curvature_raw:float = 0.0;
    flag_prob:float = 0.0;
    valid:bool = false;
}


table AutoSpeedOutput {
    detections:[Detection];
    valid:bool = false;
}


table AutoSteerOutput {
    xp:[float];
    h_vector:[float];
    valid:bool = false;
}


table CIPOFusionEstimate {
    valid:bool = false;

    distance_m:float = 0.0;
    velocity_ms:float = 0.0;
    distance_stddev_m:float = 0.0;

    cipo_raw_found:bool = false;
    cipo_raw_dist_m:float = 0.0;
    cut_in_detected:bool = false;
}


table LateralFusionEstimate {
    valid:bool = false;

    cte_m:float = 0.0;
    cte_rate_mps:float = 0.0;

    yaw_rad:float = 0.0;
    yaw_rate_rps:float = 0.0;

    cte_stddev_m:float = 0.0;
    yaw_stddev_rad:float = 0.0;

    curvature:float = 0.0;
    curv_stddev:float = 0.0;

    path_valid:bool = false;

    raw_cte_m:float = 0.0;
    raw_yaw_rad:float = 0.0;
    raw_path_curvature:float = 0.0;
    raw_ad_curvature:float = 0.0;

    path_inliers:int = 0;
    path_points:int = 0;

    path_a:float = 0.0;
    path_b:float = 0.0;
    path_c:float = 0.0;

    path_x_min_m:float = 0.0;
    path_x_max_m:float = 0.0;
}


table InferenceFrameResult {
    frame_id:ulong = 0;

    wall_ms:double = 0.0;
    pre_ms:double = 0.0;
    ad_ms:double = 0.0;
    as_ms:double = 0.0;
    asp_ms:double = 0.0;

    auto_drive:AutoDriveOutput;
    auto_steer:AutoSteerOutput;
    auto_speed:AutoSpeedOutput;

    cipo:CIPOFusionEstimate;
    lateral:LateralFusionEstimate;
}


table Plan {
    acceleration:double = 0.0;
    steering:[double];
    warnings:[Warning];
}


table VisionPilotOutput {
    inference:InferenceFrameResult;
    plan:Plan;
}


root_type VisionPilotOutput;
file_identifier "VPO1";